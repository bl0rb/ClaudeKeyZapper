Windows Registry Editor Version 5.00

; KeyZapper for Windows reads the same settings as the macOS preference file (docs/intune/io.github.bl0rb.keyzapper.plist), from
; HKLM\SOFTWARE\Policies\KeyZapper (machine, wins) or HKCU\SOFTWARE\Policies\KeyZapper.
; Strings: REG_SZ, lists: REG_MULTI_SZ, switches: REG_DWORD 0/1, ManagedProfiles: JSON array as REG_SZ.
; This sample sets every key KeyZapper reads; leave out what should keep its default (see README, "Distribution via Microsoft Intune").
;
; ManagedProfiles entry: Name, Endpoint, optional ID (UUID; otherwise derived from Name), ModelAlias, OpusModel, SonnetModel,
;   HaikuModel, Environment (object), Type ("apiKey" default or "oidc"), OIDCIssuer, OIDCClientID, OIDCScope,
;   OIDCTokenType ("access" default or "id"), ClaudeDesktop (object), Office (object).
; ClaudeDesktop: OIDCIssuer, OIDCClientID, optional GatewayURL (default: Endpoint), Scopes, BearerTokenType ("id_token" default or
;   "access_token"), CredentialKind ("external-idp" default for Claude Desktop 2.7032.0 or newer, "interactive" for older versions),
;   AutoApply (set up without a click), Config (further Claude Desktop configuration keys, written as they are).
; Office: Enabled (default true), AddinID, GatewayURL, EntraClientID, EntraScope, DisabledFeatures (array or comma-separated string).
; Users may switch on Claude in Office or Claude Desktop (SSO) themselves for a managed profile that sets neither.

[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\KeyZapper]
"ManagedProfiles"="[{\"ID\":\"7f3c2a10-5b4e-4d8a-9c1f-0e2b3a4c5d6e\",\"Name\":\"Projekt Alpha\",\"Endpoint\":\"https://litellm.firma.example\",\"ModelAlias\":\"claude-sonnet\",\"OpusModel\":\"eu.anthropic.claude-opus-5-team\",\"SonnetModel\":\"eu.anthropic.claude-sonnet-5-team\",\"HaikuModel\":\"eu.anthropic.claude-haiku-4-5\",\"Environment\":{\"CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS\":\"1\"}},{\"Name\":\"SSO Projekt\",\"Type\":\"oidc\",\"Endpoint\":\"https://litellm.firma.example\",\"OIDCIssuer\":\"https://login.microsoftonline.com/00000000-0000-4000-8000-000000000000/v2.0\",\"OIDCClientID\":\"c1abe123-4567-4890-abcd-ef0123456789\",\"OIDCScope\":\"api://c1abe123-4567-4890-abcd-ef0123456789/.default offline_access\",\"OIDCTokenType\":\"access\",\"Environment\":{\"CLAUDE_CODE_API_KEY_HELPER_TTL_MS\":\"900000\"},\"ClaudeDesktop\":{\"GatewayURL\":\"https://litellm.firma.example/api/x/desktop-gateway/desktop\",\"OIDCIssuer\":\"https://login.microsoftonline.com/00000000-0000-4000-8000-000000000000/v2.0\",\"OIDCClientID\":\"22222222-3333-4444-8555-666666666666\",\"Scopes\":\"openid profile email offline_access\",\"BearerTokenType\":\"id_token\",\"CredentialKind\":\"external-idp\",\"AutoApply\":true,\"Config\":{\"disableDeploymentModeChooser\":true,\"chatTabEnabled\":true,\"desktopHome\":\"standard\",\"disableFeatureDiscovery\":true,\"disableEssentialTelemetry\":true,\"disableNonessentialTelemetry\":true,\"disabledBuiltinTools\":[\"WebSearch\"],\"coworkEgressAllowedHosts\":[\"*.firma.example\"],\"deploymentDisplayName\":\"Firma\",\"deploymentDisplaySubtitle\":\"0.1.0 (PoC)\",\"banner\":{\"enabled\":true,\"text\":\"Firma Claude Desktop PoC\",\"backgroundColor\":\"#005E52\",\"textColor\":\"#FFFFFF\",\"linkUrl\":\"https://wiki.firma.example/claude\"}}},\"Office\":{\"Enabled\":true,\"AddinID\":\"5c1d7e2a-8b3f-4e6d-9a0c-2f4b6d8e1a3c\",\"GatewayURL\":\"https://litellm.firma.example/api/x/desktop-gateway/office\",\"EntraClientID\":\"11111111-2222-4333-8444-555555555555\",\"EntraScope\":\"api://11111111-2222-4333-8444-555555555555/access_as_user\",\"DisabledFeatures\":[\"web_search\"]}}]"
; AllowedGatewayHosts as REG_MULTI_SZ: litellm.firma.example, *.litellm.firma.example
"AllowedGatewayHosts"=hex(7):6c,00,69,00,74,00,65,00,6c,00,6c,00,6d,00,2e,00,66,00,69,00,72,00,6d,\
  00,61,00,2e,00,65,00,78,00,61,00,6d,00,70,00,6c,00,65,00,00,00,2a,00,2e,00,\
  6c,00,69,00,74,00,65,00,6c,00,6c,00,6d,00,2e,00,66,00,69,00,72,00,6d,00,61,\
  00,2e,00,65,00,78,00,61,00,6d,00,70,00,6c,00,65,00,00,00,00,00
"DefaultEndpoint"="https://litellm.firma.example"
"DefaultModelAlias"="claude-sonnet"
"MinimumClaudeCodeVersion"="2.1.288"
"OneDriveBackup"=dword:00000001
; BackupDirectory: explicit backup folder (enables the backup even without OneDriveBackup); ~ stands for the user profile folder.
"BackupDirectory"="~\\OneDrive - Firma\\KeyZapper"
"UpdateCheckEnabled"=dword:00000000
"AllowKeyExport"=dword:00000001
"ManagedMcpServersURL"="https://sso.firma.example/keyzapper/mcp-servers.json"
"ClaudeToolsEnabled"=dword:00000001
"ClaudeDesktopAutoInstall"=dword:00000000
